NEXT_PUBLIC_SERVER_IP=play.turturesmp.dpdns.org
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/yourinvite
# Optional: enables live Discord online count (Server Settings > Widget > Enable)
NEXT_PUBLIC_DISCORD_SERVER_ID=
# Bedrock (Geyser) address and port
NEXT_PUBLIC_BEDROCK_IP=play.turturesmp.dpdns.org
NEXT_PUBLIC_BEDROCK_PORT=19132
# Optional: link for the Store page's Buy buttons
NEXT_PUBLIC_STORE_URL=

# ---- Admin / database (add these in .env.local, never commit real values) ----
# MongoDB connection string, e.g. from MongoDB Atlas
MONGODB_URI=
MONGODB_DB=turturesmp
# Discord login for the admin panel (https://discord.com/developers/applications)
# Redirect URL to add in the Discord app: <SITE_URL>/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Random secret, 32+ characters:  openssl rand -hex 32
AUTH_SECRET=
# Your Discord user ID (comma separated for several). These people become Owner on first login.
OWNER_DISCORD_IDS=
# Public address of the site, no trailing slash (needed for the Discord redirect)
SITE_URL=http://localhost:3000

# ---- Minecraft server bridge (same value goes in the plugin's config.yml `secret`) ----
# Random secret, 32+ characters:  openssl rand -hex 32
BRIDGE_SECRET=

# ---- Payments (store checkout) ----
# INR: Razorpay (Dashboard > Settings > API Keys; webhook URL: <SITE_URL>/api/webhooks/razorpay, events payment.captured + order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# USD: Stripe (webhook URL: <SITE_URL>/api/webhooks/stripe, event checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Protects /api/cron/expire (call daily so expired ranks and tags are removed)
CRON_SECRET=
