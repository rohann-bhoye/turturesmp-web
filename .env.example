NEXT_PUBLIC_SERVER_IP=play.turturesmp.dpdns.org
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/yourinvite
# Optional: enables live Discord online count (Server Settings > Widget > Enable)
NEXT_PUBLIC_DISCORD_SERVER_ID=
# Bedrock (Geyser) address and port
NEXT_PUBLIC_BEDROCK_IP=play.turturesmp.dpdns.org
NEXT_PUBLIC_BEDROCK_PORT=19132
# Optional: link for the Store page's Buy buttons
NEXT_PUBLIC_STORE_URL=

# ---- Admin / database (add these in .env.local, never commit real values) ----
# MongoDB connection string, e.g. from MongoDB Atlas
MONGODB_URI=
MONGODB_DB=turturesmp
